# Google Sheets
GOOGLE_SHEET_ID=1tUMUbXKOVxvj0UsuvQpLJKxSGSsFjltNHzGheL8o-70
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----\\n"

# Admin - store ONLY a bcrypt hash, never the plaintext password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Order channels
VITE_SITE_OPEN=true
VITE_WHATSAPP_NUMBER=905XXXXXXXXX
VITE_COMPANY_EMAIL=siparis@umeradesign3d.com

# Otomatik sipariş durum bildirimi (en az bir kanal yapılandırılmalı)
# E-posta / Resend: doğrulanmış alan adınızdan bir gönderici kullanın.
RESEND_API_KEY=re_xxxxxxxxx
ORDER_NOTIFICATION_FROM=UMERA Design 3D <siparis@umeradesign3d.com>

# WhatsApp Business Cloud API: onaylı şablon gövdesi sırasıyla
# {{1}} müşteri adı, {{2}} sipariş no, {{3}} sipariş durumu değişkenlerini içermeli.
WHATSAPP_ACCESS_TOKEN=EAxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_STATUS_TEMPLATE_NAME=umera_siparis_durumu
WHATSAPP_STATUS_TEMPLATE_LANGUAGE=tr
WHATSAPP_GRAPH_VERSION=v23.0

# Havale / EFT ödeme bilgisi — müşteri sipariş fişinde ve bildirimlerde görür.
# IBAN'ı repoya değil, buraya/Vercel ortam değişkenlerine koy.
ODEME_IBAN=TR000000000000000000000000
ODEME_ALICI=Ad Soyad veya Firma Unvanı
ODEME_BANKA=Banka Adı

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx
# Public product/custom-image store (Vercel Blob)
UMERA_PUBLIC_STORE_ID=store_xxxxxxxxx
UMERA_PUBLIC_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx
